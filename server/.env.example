# Application Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://maraki@localhost/bluenex?host=/tmp
TEST_DATABASE_URL=postgresql://maraki@localhost/bluenex_test?host=/tmp

# Initial Super Admin Seed Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@bilunex.org
ADMIN_PASSWORD=replace_with_secure_admin_password

# Authentication & JWT
JWT_SECRET=replace_with_long_random_jwt_secret_key
JWT_EXPIRES_IN=1d

# Email Delivery Configuration (Nodemailer)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Bilunex Support" <no-reply@bilunex.org>
ADMIN_NOTIFICATION_EMAIL=admin@bilunex.org
